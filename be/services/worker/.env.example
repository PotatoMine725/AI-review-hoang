# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
FAL_KEY=
# OpenAI, khâu edit video (bước `edit`). Dán khoá thật vào services/worker/.env, không vào file này
OPENAI_API_KEY=
# Tự quay clip demo (python -m worker.demo). Model OpenAI sinh script: bắt buộc cho `generate`
# DEMO_LLM_MODEL=
# DEMO_CHROMIUM_PATH=   # tuỳ chọn: dùng Chrome/Chromium có sẵn thay cho `playwright install`
# DEMO_HEADLESS=1      # 0 = hiện cửa sổ trình duyệt

# Crawl M1 (tuỳ chọn, mặc định bằng spike). Xem services/worker/README.md
# M1_CRAWL_MAX_PAGES=30
# M1_CRAWL_MIN_INTERVAL_S=1.0
# M1_CRAWL_CONCURRENCY=3        # số trang mở cùng lúc (vẫn ≤ 1 request/giây/host); 1 = tuần tự
# M1_CRAWL_WAIT_STABLE=1        # chờ chữ ổn định thay vì chờ cố định RENDER_DELAY_S; 0 = chờ cố định
# M1_CRAWL_STABLE_FOR_S=1.0     # chữ không đổi bấy nhiêu giây thì coi là xong
# M1_CRAWL_TEXT_MODE=1          # không tải ảnh/font
# M1_CRAWL_USER_AGENT=
# M1_CRAWL_REGION=VN
# Ngôn ngữ trang được crawl, theo thứ tự ưu tiên (bản dịch trùng chỉ giữ bản đứng trước)
# M1_CRAWL_LANGUAGES=en,vi

# LLM M1 (ADR-0002). gemini = gọi API thật (cần GEMINI_API_KEY); fixture = đọc response đã lưu, không gọi mạng
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_MAX_OUTPUT_TOKENS=16384
# LLM_TIMEOUT_S=180
# LLM_RETRY_DELAYS_S=5,10,20,40,60
# LLM_FIXTURE_PATH=

# P1-08 ghép kịch bản → MP4 (tuỳ chọn). Spike #73/#88/#77 chưa nằm trong repo này nên trỏ tới worktree của chúng
# PRODUCE_TTS_SPIKE=<.../p1-tts-vi/spikes/p1-tts-vi>
# PRODUCE_RENDER_V2=<.../p1-render-v2/spikes/p1-render-v2>
# PRODUCE_RENDER_FF=<.../spike-p1-render/spikes/p1-render>   # chỉ để đọc mốc 40–45 s (config.py của #77)
# PRODUCE_CACHE_DIR=            # cache TTS theo hash, mặc định ~/.cache/ai-review-produce
# PRODUCE_VOICE=Hải Đăng        # giọng VieNeu v3 Turbo (mặc định Hải Đăng)
# PRODUCE_TTS_MAX_CHARS=60      # 60 = mỗi câu sinh riêng, ngữ điệu reset theo câu; 0 = mặc định SDK
# PRODUCE_TTS_DEVICE=cpu        # cpu = ONNX (mặc định), cuda, auto
# PRODUCE_STT_MODEL=whisper-1    # mốc từng từ cho phụ đề (OpenAI, cần OPENAI_API_KEY); bỏ trống = chia theo ký tự
# PRODUCE_QA_MODEL=gpt-5.4-mini    # QA khung hình bằng mô hình thị giác (OpenAI, cần OPENAI_API_KEY); bỏ trống = tắt
# PRODUCE_GAP_S=0.12            # nghỉ giữa hai câu, tối đa 0.15
# PRODUCE_WORKERS=3             # --workers HyperFrames cho mỗi tỉ lệ (render_mode=sequential)
# PRODUCE_RENDER_MODE=sequential  # sequential | parallel (chia theo cảnh, P1-09)
# PRODUCE_RENDER_JOBS=4         # parallel: số tiến trình HyperFrames cùng lúc, bị chặn bởi RAM còn trống
# PRODUCE_RENDER_JOB_RAM_MB=1900   # parallel: đỉnh RAM mỗi tiến trình (dùng để chặn số tiến trình)
# PRODUCE_RENDER_RAM_RESERVE_MB=2048  # parallel: RAM chừa lại cho hệ điều hành
# PRODUCE_RENDER_CACHE=1        # parallel: cache MP4 theo cảnh trong <PRODUCE_CACHE_DIR>/render-scenes; 0 hoặc --no-cache để tắt
# PRODUCE_HF_ARGS=              # cờ thêm cho hyperframes render (để đo), vd. --experimental-fast-capture
# PRODUCE_HF_ENV=               # biến môi trường thêm cho render, dạng A=1,B=2 (vd. HYPERFRAMES_RENDER_LOCK=off)

# M2 sinh kịch bản. Tốc độ đọc giả định để tính estimated_duration_s (ước tính, không phải duration TTS/MP4)
# M2_SYLLABLES_PER_S=3.75

# --- API P1 (xem docs/specs/p1-secrets-and-quota.md). Chỉ để giá trị thật trong .env ---
SUPABASE_ANON_KEY=
# Token chung để n8n gọi endpoint dịch vụ (header X-Service-Token). Sinh: openssl rand -hex 32
N8N_SERVICE_TOKEN=
# Ảnh AI (Cloudflare Workers AI), tên chuẩn của nhà cung cấp
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Ngưỡng chi phí một job (USD). Trống = không chặn
# JOB_COST_LIMIT_USD=0.10
# WORKER_HTTP_TIMEOUT_S=15

# --- Bộ chạy job (python -m worker.runner) ---
# WORKER_PAGE_STORE_DIR=./data/pages
# RUNNER_POLL_INTERVAL_S=5
# RUNNER_MAX_ATTEMPTS=3
# RUNNER_RETRY_BACKOFF_S=30
# WORKER_VIDEO_DIR=./data/videos   # job video: nơi ghi MP4 + render_report.json (máy render)

# --- Web (CORS) ---
# WORKER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # origin của FE, cách nhau bằng dấu phẩy

    {"op": "click", "selector": "text=\"Combine Files & Merge PDF\" >> nth=0"},
    {"op": "wait", "ms": 1200},
    {"op": "click", "selector": "button:has-text(\"mau-b.pdf\"):has-text(\"+\") >> nth=-1"},
    {"op": "wait", "ms": 900},
    {"op": "click", "selector": "role=button[name=\"Append\"] >> nth=-1"},
    {"op": "wait", "ms": 3000},
    {"op": "hover", "selector": "iframe >> nth=0"},
    {"op": "scroll", "dy": 1300},
    {"op": "wait", "ms": 600},
    {"op": "scroll", "dy": 1300},
    {"op": "wait", "ms": 600},
    {"op": "scroll", "dy": 1300},
    {"op": "wait", "ms": 2000}
  ]

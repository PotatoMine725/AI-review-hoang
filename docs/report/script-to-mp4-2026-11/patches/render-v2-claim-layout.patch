--- /dev/null
+++ b/spikes/p1-render-v2/template/layouts/claim.html
@@ -0,0 +1,55 @@
+<!--
+  Layout "claim": chỉ có chữ. Cho cảnh có claim nhưng không có số liệu để làm layout stat và không có
+  clip để làm feature_clip (vd cảnh proof / text_card của M2 khi claim không có stat_display).
+  Hiện claim NGUYÊN VĂN: không rút gọn, không tách thành giá trị + nhãn. Icon trung tính, không minh hoạ theo nghĩa.
+  props: eyebrow{text}, icon, claim{text,highlight}, points[{text,icon}]
+  Lớp hiện dần: minh hoạ (0 s) → eyebrow (0,25) → claim (0,5) → ý phụ (0,9 + i×0,3)
+-->
+<div class="scene layout-claim" data-layout="claim">
+  <style>
+    .layout-claim .safe { display: flex; align-items: center; }
+    .layout-claim.is-portrait .safe { flex-direction: column; justify-content: center; gap: 52px; }
+    .layout-claim.is-landscape .safe { flex-direction: row; gap: 90px; }
+    .layout-claim .illo { position: relative; flex: none; display: grid; place-items: center; }
+    .layout-claim.is-portrait .illo { width: 320px; height: 320px; }
+    .layout-claim.is-landscape .illo { width: 520px; height: 520px; }
+    /* Vòng tròn đồng tâm xoay chậm phía sau icon (cùng kiểu layout stat) */
+    .layout-claim .rings { position: absolute; inset: 0; animation: ring-spin 24s linear both; }
+    .layout-claim .rings circle { fill: none; stroke: var(--accent-2); stroke-opacity: 0.25; stroke-width: 1.5; }
+    .layout-claim .rings circle:nth-child(2) { stroke: var(--accent); stroke-dasharray: 6 14; stroke-opacity: 0.5; }
+    .layout-claim .illo .icon-tile { width: 46%; height: 46%; border-radius: 30%; }
+    .layout-claim .copy { display: flex; flex-direction: column; gap: 30px; min-width: 0; }
+    .layout-claim.is-portrait .copy { align-items: center; text-align: center; }
+    .layout-claim .claim { font-size: calc(var(--fs-title) * 0.85); --hl-d: 1.1s; }
+    .layout-claim .points { display: flex; flex-direction: column; gap: 16px; }
+    .layout-claim .point { display: flex; align-items: flex-start; gap: 18px; padding: 18px 26px; text-align: left;
+      border-radius: 36px; background: rgba(255, 255, 255, 0.06); border: 1px solid var(--surface-line);
+      font-weight: 700; font-size: var(--fs-body); line-height: 1.3; }
+    .layout-claim .point svg { width: 1.1em; height: 1.1em; margin-top: 0.1em; color: var(--accent); flex: none; }
+  </style>
+
+  <div class="bg"></div>
+  <div class="bg-dots"></div>
+  <div class="orb orb-a"></div>
+  <div class="orb orb-c"></div>
+
+  <div class="safe">
+    <div class="illo a-pop" style="--d: 0s">
+      <svg class="rings" viewBox="0 0 200 200">
+        <circle cx="100" cy="100" r="98" /><circle cx="100" cy="100" r="80" /><circle cx="100" cy="100" r="62" />
+      </svg>
+      <span class="icon-tile" data-icon="icon"></span>
+    </div>
+    <div class="copy">
+      <div class="eyebrow a-rise" style="--d: 0.25s" data-text="eyebrow"></div>
+      <h2 class="title claim a-rise" style="--d: 0.5s" data-text="claim"></h2>
+      <div class="points" data-list="points">
+          <div data-item class="point a-pop" style="--d: calc(0.9s + var(--i) * 0.3s)">
+            <span data-icon="icon"></span><span data-text="text"></span>
+          </div>
+      </div>
+    </div>
+  </div>
+
+  <script>window.TPL.mount("claim");</script>
+</div>

// Nguồn: @tranquangthong03 gửi nhóm ngày 2026-10-07 (file gốc: erd_v0.dbml, nội dung ERD v1.3.1).
// Đưa vào repo nguyên văn. Trạng thái: chờ @VV6505 duyệt (decision-log #12). Góp ý: issue #23.
// File này là nguồn chuẩn của ERD; erd.mermaid và data-dictionary.md diễn giải từ file này.
// v1.3.3 (2026-10-08, Issue #23 follow-up, decision-log #18): PKB review metadata (review_note,
// reviewer_role; rename approved_by/approved_at -> reviewed_by/reviewed_at); content_scripts cost columns.

Project ai_review_mvp_v1_3_3 {
  database_type: 'PostgreSQL'
  Note: '''MVP SCHEMA BASELINE v1.3.3, 2026-10-08 (baseline v1.3.1 2026-10-07; v1.3.3 adds PKB review metadata and content_scripts cost columns per Issue #23, decision-log #17). 16 business tables plus existing Supabase auth.users. Scope frozen for one-month pilot: one merchant per product, one product per campaign, manual QA and posting, one language/template/provider, USD, one-time flat/percentage commission. No recurring commission, wallet, automated payout, vector RAG or partial-refund automation.
This DBML is the agreed implementation target for this iteration, NOT an executable production migration. SQL REQUIRED notes are acceptance requirements. Preserve and ALTER existing profile tables; do not recreate auth.users.
Eligibility means first valid paid event successfully accepted by the database for a canonical (product, source, external_user_id), NOT earliest occurred_at or lifetime first purchase outside known data. That first payment consumes eligibility even without attribution. Subsequent valid payments remain revenue but create no additional commission. Full reversal never frees eligibility automatically.
Release configuration must explicitly set attribution_window_days, revenue_basis, settlement_hold_days and policy_version before processing paid events. No silent defaults. These are configuration choices, not additional tables. The merchant integration must return a verifiable click_id; missing/invalid attribution earns no commission.'''
}

// AUTH: existing Supabase table; not counted in business tables.
Table auth.users {
  id uuid [pk]
  email text
}

// ============================================================================
// SECTION 1 — EXISTING PROFILES (Task 1 + Task Merchant, existing in supplied source; deployment status verified separately)
// ============================================================================

// 01. Existing Merchant profile
Table merchants {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, default: `auth.uid()`, ref: - auth.users.id]
  company_name text [not null]
  company_slug text [not null, unique]
  website text
  logo_url text
  description text
  contact_email text
  country text
  status text [not null, default: 'pending', check: `status IN ('pending','active','suspended')`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { status }
  Note: 'EXISTING TABLE. Preserve checks, normalization, owner RLS, column grants, slug lifecycle trigger. Admin role must be server-controlled.'
}

// 02. Existing Creator profile
Table creators {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, default: `auth.uid()`, ref: - auth.users.id]
  display_name text [not null]
  bio text
  niche text
  language text
  country text
  avatar_url text
  status text [not null, default: 'pending', check: `status IN ('pending','active','suspended')`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'EXISTING TABLE. FIX: add UNIQUE(user_id) after checking duplicates (migration 20261007XXXXXX). Preserve profile checks/RLS/grants. Same user may have both creator and merchant profiles.'
}

// 03. Existing social accounts
Table creator_accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  creator_id uuid [not null, ref: > creators.id]
  platform text [not null]
  handle text [not null]
  platform_handle text [unique, note: 'SQL REQUIRED: preserve GENERATED ALWAYS AS platform || colon || handle STORED and normalization.']
  url text
  follower_count bigint [not null, default: 0, check: `follower_count >= 0`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { 
    creator_id
    (id, creator_id) [unique]
  }
  Note: 'EXISTING TABLE. creator_id resolved server-side, immutable. Preserve checks/RLS/grants. Handle uniqueness is not ownership verification. Lock platform after referenced by any selected or published post.'
}

// ============================================================================
// SECTION 2 — PRODUCT INTELLIGENCE (Task 3 prerequisite)
// ============================================================================

// 04. Product intake; JSON stores optional merchant input.
Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  merchant_id uuid [not null, ref: > merchants.id]
  website_url text [not null, unique]
  affiliate_url text [not null, note: 'Validated redirect destination, not program information page.']
  name text [note: 'May be null during URL-only intake; required before activation.']
  description text
  category text
  merchant_input jsonb [not null, default: `'{}'::jsonb`]
  current_knowledge_version int
  status text [not null, default: 'draft', check: `status IN ('draft','active','archived')`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { 
    merchant_id
    (id, merchant_id) [unique]
  }
  Note: 'SQL REQUIRED: canonical URL + HTTP(S) validation; merchant ownership resolved server-side. Active requires name and approved PKB. Current PKB pointer must be approved. Immutable merchant when referenced. Domain uniqueness NOT imposed — confirm with M1 team.'
}

// 05. PKB: authoritative pricing/features/evidence, versioned JSON.
Table product_knowledge {
  product_id uuid [not null, ref: > products.id]
  version int [not null, check: `version > 0`]
  status text [not null, default: 'draft', check: `status IN ('draft','in_review','approved','rejected')`]
  data jsonb [not null, note: 'Schema-validated: identity, pricing, features, audience, USP, limitations, brand, claims; facts carry source IDs.']
  sources jsonb [not null, note: 'Source IDs, URLs, crawl times, hashes, evidence excerpts and private Storage paths.']
  reviewed_by uuid [ref: > auth.users.id, note: 'Actor (merchant or admin) who approved or rejected the PKB; set for BOTH approve and reject paths, not just approve. Renamed from approved_by in v1.3.3 (Issue #23).']
  reviewed_at timestamptz [note: 'Timestamp of the approve or reject action; set for BOTH paths. Renamed from approved_at in v1.3.3 (Issue #23).']
  reviewer_role text [check: `reviewer_role IN ('merchant','admin')`, note: 'Whether the actor was the owning merchant or an admin (pilot rule: merchant approves; admin can only reject for policy violations). Nullable.']
  review_note text [note: 'Reason for a PKB rejection, or an approval note. Nullable; max length 1000 characters. Review metadata, NOT part of the data JSON payload (data is bound by PKB v0.2 with additionalProperties: false).']
  created_at timestamptz [not null, default: `now()`]
  indexes { (product_id, version) [pk] }
  checks { `status <> 'approved' OR (reviewed_by IS NOT NULL AND reviewed_at IS NOT NULL)` }
  Note: 'SQL REQUIRED: approved row immutable; recrawl/edit creates new version. Allocate versions transactionally. Validate fact sources. Authorized merchant/admin approves. Use approved JSON directly as AI input; no vector RAG in pilot.
LIFECYCLE: draft -> in_review -> approved | rejected. in_review is submitted by merchant awaiting review; approved requires merchant approver; rejected may be set by admin for policy violations.
REVIEW METADATA (v1.3.3, Issue #23): reviewed_by + reviewed_at record the actor and timestamp for BOTH approve and reject (renamed from approved_by/approved_at, which named only the approve path). reviewer_role records merchant vs admin. review_note stores the rejection reason (or an approval note), max 1000 characters. All these columns are nullable at the DB level; the valid combination per status is SQL REQUIRED (see the migration gate) and is NOT enforced in this task. reviewed_by FK -> auth.users.id. review_action is intentionally NOT a column; the terminal outcome is already recorded in status (approved or rejected). This avoids a redundant pair of columns that would need to stay in sync.
APPROVAL PERMISSIONS (PLANNED — not enforced by any migration): only the merchant who owns the product may approve its PKB. Admin may reject a PKB only for policy violations, and that rejection must record a reason which is retained. Admin cannot edit or approve PKB content. Approval and rejection must record the actor and timestamp.
GAP (rejection reason): RESOLVED in v1.3.3 (Issue #23) — product_knowledge.review_note now stores the rejection reason (nullable, max 1000 characters, required and non-empty when status = rejected). It is review metadata and does not live inside the data JSON payload because data is bound by PKB v0.2 with additionalProperties: false.
GAP (reject semantics): RESOLVED in v1.3.3 (Issue #23) — approved_by/approved_at were renamed to reviewed_by/reviewed_at so they record BOTH approve and reject, and reviewer_role plus review_note were added (review_action was dropped on M1 review as redundant with status). See SQL REQUIRED (PKB review consistency) in the migration gate.
CONFLICT (historical, noted not skipped): status change applied per Issue #23 approval. Historical conflict with SRS FR-PI-03 and M1 spec FR-07 (which list only draft/in_review/approved) is flagged for update in their respective specs; M1 spec v0.3 update is tracked in Issue #23. Separately, BRD 5.x line 542, SRS FR-PI-03 (line 356), M1 spec FR-07 and qa-log #1 / decision-log #11 state that Platform Admin does not participate in PKB approval in the MVP; the admin policy-reject rule above is not yet reconciled with those documents, which take precedence until updated.'
}
Ref: products.(id, current_knowledge_version) > product_knowledge.(product_id, version)

// ============================================================================
// SECTION 3 — CAMPAIGN & ENROLLMENT
// ============================================================================

// 06. Campaign: one product, fixed commission for the pilot.
Table campaigns {
  id uuid [pk, default: `gen_random_uuid()`]
  merchant_id uuid [not null, ref: > merchants.id]
  product_id uuid [not null]
  name text [not null]
  slug text [not null, unique]
  description text
  start_date timestamptz [not null]
  end_date timestamptz [not null]
  target_audience text
  target_countries text[]
  target_language text [not null]
  content_brief text
  approved_claims text[]
  forbidden_claims text[]
  cta text
  commission_type text [not null, check: `commission_type IN ('flat','percentage')`]
  commission_value numeric(12,4) [not null]
  currency varchar(3) [not null, check: `currency = 'USD'`, note: 'Pilot: USD only.']
  terms_locked_at timestamptz [note: 'Server-managed permanent marker, set atomically by first enrollment; never cleared.']
  status text [not null, default: 'draft', check: `status IN ('draft','active','paused','ended','archived')`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { 
    (id, product_id) [unique]
    status
  }
  checks {
    `end_date > start_date`
    `commission_value >= 0 AND (commission_type <> 'percentage' OR commission_value <= 100)`
  }
  Note: 'SQL REQUIRED (D008): active merchant/product and approved PKB before activation. Enrollment transaction locks campaign FOR UPDATE, sets terms_locked_at if null, snapshots terms and inserts enrollment. Campaign UPDATE trigger rejects changes to merchant_id, product_id, commission_type, commission_value or currency whenever OLD.terms_locked_at is set; marker immutable thereafter and not client-writable. Prevent changing terms and setting lock in same operation. No enrollment deletion or reassignment. Lock campaign before enrollment. Existing enrollment backfill sets marker before opening writes. Change commission via NEW campaign. Claim changes require affected videos to be withdrawn/re-reviewed. Currency USD only; validate in SQL.'
}
Ref: campaigns.(product_id, merchant_id) > products.(id, merchant_id)

// 07. One enrollment per creator/campaign; rejoin reuses it. Snapshot terms immutable.
Table creator_campaigns {
  id uuid [pk, default: `gen_random_uuid()`]
  creator_id uuid [not null, ref: > creators.id]
  campaign_id uuid [not null, ref: > campaigns.id]
  status text [not null, default: 'active', check: `status IN ('active','left','removed')`]
  commission_type_snapshot text [not null, check: `commission_type_snapshot IN ('flat','percentage')`]
  commission_value_snapshot numeric(12,4) [not null]
  currency_snapshot varchar(3) [not null, check: `currency_snapshot = 'USD'`]
  joined_at timestamptz [not null, default: `now()`]
  left_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (creator_id, campaign_id) [unique]
    (id, creator_id, campaign_id) [unique]
    status
  }
  checks {
    `commission_value_snapshot >= 0 AND (commission_type_snapshot <> 'percentage' OR commission_value_snapshot <= 100)`
    `(status = 'active' AND left_at IS NULL) OR (status IN ('left','removed') AND left_at IS NOT NULL)`
  }
  Note: 'SQL REQUIRED: derive creator from auth.uid(); snapshot terms from campaign under FOR UPDATE lock, set permanent terms_locked_at in same transaction. creator_id/campaign_id and snapshots immutable; no DELETE. Snapshots immutable. Join/rejoin only eligible active campaign within dates. Rejoin retains original joined_at AND original commission snapshots (D009) — clears left_at. Removed creators require admin reinstatement. Existing eligible clicks keep original attribution after exit. Commission change requires new campaign.'
}

// ============================================================================
// SECTION 4 — CONTENT & VIDEO GENERATION
// ============================================================================

// 08. Idea + hook + script in one table. Backend-only writes.
Table content_scripts {
  id uuid [pk, default: `gen_random_uuid()`]
  campaign_id uuid [not null]
  product_id uuid [not null]
  knowledge_version int [not null]
  idea text
  hook text
  intent text [check: `intent IN ('awareness','education','consideration','conversion')`]
  script_text text [not null]
  platform text [not null]
  language text [not null]
  cost_breakdown jsonb [default: `'{}'::jsonb`, note: 'Same cost_breakdown v1 contract as generation_jobs.cost_breakdown (docs/specs/contracts/cost-breakdown.v1.schema.json). Worker/backend writes this column; empty object means cost not yet recorded.']
  cost_usd numeric(12,6) [note: 'Derived from cost_breakdown by the database; worker never writes it. Same type numeric(12,6) and same derivation rules as generation_jobs.cost_usd. Nullable, no default.']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (id, campaign_id) [unique]
    campaign_id
  }
  Note: 'SQL REQUIRED (D012): sync API generation with request idempotency; service_role writes only after API authorization. RLS: deny all INSERT/UPDATE/DELETE from authenticated. SELECT restricted to owning merchants and authorized admin/backend; creators receive approved videos, not raw scripts. Approved PKB only. Script immutable once used; revision creates new row. No separate idea/hook workflow in pilot.
COST (v1.3.3, Issue #23): content scripts are generated via sync API (D012) and have no generation_jobs entry, but they still consume LLM cost. cost_breakdown (cost_breakdown v1 contract) plus the DB-derived cost_usd keep the NFR-02 cost/product measurement from missing the script-generation step. tokens_in/tokens_out are intentionally NOT added in MVP (M1 initially proposed only 2 columns, NFR-02 measures cost not tokens, and scripts use a single LLM call unlike batch crawl); add them later by additive migration if the AI team needs script tokens.
COST SCOPE NOTE (Issue #23): the cost_breakdown and cost_usd columns on content_scripts measure M2's own script-generation cost. This measurement is separate from M1's NFR-02 budget (≤ $0.05/product), which only counts crawl + extract. The pilot tracks this cost for visibility; it does NOT include it in the total product budget. Column design and derivation rules are unchanged.'
}
Ref: content_scripts.(campaign_id, product_id) > campaigns.(id, product_id)
Ref: content_scripts.(product_id, knowledge_version) > product_knowledge.(product_id, version)

// 09. Shared job status for crawl or video generation.
Table generation_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null, ref: > products.id]
  content_script_id uuid [ref: > content_scripts.id]
  job_type text [not null, check: `job_type IN ('crawl','video')`]
  status text [not null, default: 'queued', check: `status IN ('queued','running','completed','failed')`]
  idempotency_key text [not null, unique]
  input_snapshot jsonb [not null]
  result_manifest jsonb [note: 'PKB version or video IDs + Storage paths; NOT a second source of truth.']
  error text
  attempts int [not null, default: 0, check: `attempts >= 0`]
  tokens_in int [note: 'Derived from cost_breakdown by the database; worker never writes it. Nullable: nullability is not stated by authoritative inputs — see the cost note below.']
  tokens_out int [note: 'Derived from cost_breakdown by the database; worker never writes it. Nullable: nullability is not stated by authoritative inputs — see the cost note below.']
  cost_usd numeric(12,6) [note: 'Derived from cost_breakdown by the database; worker never writes it. 6 decimals; no 4-decimal rounding. Nullable: nullability is not stated by authoritative inputs — see the cost note below.']
  cost_breakdown jsonb [default: `'{}'::jsonb`, note: 'cost_breakdown v1 contract (docs/specs/contracts/). Worker writes only this column. Empty object means cost not yet recorded; it is NOT a valid v1 payload and does NOT mean the job cost is zero. Estimated items stay distinguishable via per-item cost_status.']
  created_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
  checks {
    `(job_type = 'crawl' AND content_script_id IS NULL) OR (job_type = 'video' AND content_script_id IS NOT NULL)`
  }
  Note: 'SQL REQUIRED: script belongs to product. Worker-only writes. Claim jobs atomically, bounded retry, idempotent output persistence. One job per generated output; deliberate rerun uses new key. Background queue is implementation concern.
COST / TOKEN (PLANNED — issue #23, contract cost_breakdown v1): worker writes cost_breakdown only; the database derives tokens_in, tokens_out and cost_usd from it. Aggregation, derivation, validation, write restrictions, budget limits and alerts are NOT implemented in this task (no trigger, generated column or RPC added). Retry calls are extra items and are included in the totals per the merged contract; failed jobs still retain cost already incurred; cost_usd is numeric(12,6) with no 4-decimal rounding. Cache behaviour, token accounting and cost_status follow cost_breakdown v1 exactly. Backend validation is additionally planned to check (a) call_id is unique within items and (b) tokens_in_cached <= tokens_in for each applicable item.
COST NULLABILITY (resolved, Issue #23): the 3 total columns are nullable by design to distinguish three states: cost_breakdown = ''{}'' -> 3 columns NULL (cost not yet recorded); cost_breakdown = valid v1 payload with items[].cost_usd = 0 -> 3 columns = 0 (job genuinely cost $0, e.g. full cache hit); cost_breakdown = normal v1 payload -> 3 columns > 0. Assigning default 0 or NOT NULL would lose the distinction between "not yet measured" and "measured as zero", producing incorrect NFR-02 cost/product dashboards. No schema change in this task.'
}

// 10. Video output + distribution text + manual QA.
Table videos {
  id uuid [pk, default: `gen_random_uuid()`]
  campaign_id uuid [not null, ref: > campaigns.id]
  content_script_id uuid [not null]
  generation_job_id uuid [not null, unique, ref: - generation_jobs.id]
  parent_video_id uuid [ref: > videos.id, note: 'Optional variant lineage; each variant is a normal video.']
  storage_path text [not null]
  thumbnail_path text
  caption text [not null]
  hashtags text[]
  cta text
  posting_instructions text
  first_approved_at timestamptz [note: 'Set on first approval, never cleared or changed; permanent content lock.']
  evidence jsonb [not null, note: 'Source references + test recording/output paths; empty evidence cannot support tested-experience claims.']
  review_notes text [note: 'Mutable after approval (D010).']
  merchant_flagged_at timestamptz [note: 'Server-supplied timestamp of a merchant report. Nullable, no default.']
  merchant_flag_reason text [note: 'Reason supplied with a merchant report; must be non-empty when a flag is submitted. Nullable, no default.']
  status text [not null, default: 'pending_review', check: `status IN ('pending_review','approved','rejected','archived')`]
  reviewed_by uuid [ref: > auth.users.id]
  reviewed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes { 
    (id, campaign_id) [unique]
    campaign_id
    status
  }
  checks {
    `status <> 'approved' OR first_approved_at IS NOT NULL`
    `first_approved_at IS NULL OR (reviewed_by IS NOT NULL AND reviewed_at IS NOT NULL AND status IN ('approved','archived'))`
  }
  Note: 'SQL REQUIRED (D010): first approval atomically sets first_approved_at, reviewed_by and reviewed_at. Once first_approved_at is set, freeze campaign_id, content_script_id, generation_job_id, parent_video_id, storage_path, thumbnail_path, caption, hashtags, cta, posting_instructions, evidence and original approval metadata. Freeze applies even after archive; changing content in same UPDATE that archives is forbidden. Admin may edit review_notes; approved can only transition to archived, archived is terminal. Revisions create a new row and require fresh QA. Job must be video type and use same script; parent must be a different video in same campaign. Server-only QA and signed authorized downloads.
MERCHANT FLAG (PLANNED — enforcement not implemented; no trigger, RPC or policy added in this task): only the merchant who owns the video product may flag it; ownership resolves video -> campaign -> product -> merchants (merchant_id). A submitted flag requires a timestamp and a non-empty reason, and merchant_flagged_at is supplied by the server, not the client. Flagging does not approve, reject, archive or remove a video, and does not change its status. Admin remains responsible for video approval (first_approved_at / reviewed_by / reviewed_at). These two columns store at most one current flag: they provide no report history and no moderation workflow. Repeated-report / overwrite behaviour is NOT decided by this task. Do not add report tables, moderation statuses, automatic takedown logic or additional audit fields.'
}
Ref: videos.(content_script_id, campaign_id) > content_scripts.(id, campaign_id)

// ============================================================================
// SECTION 5 — DISTRIBUTION & TRACKING
// ============================================================================

// 11. Selected post exists before publishing, so a link can exist first.
Table published_posts {
  id uuid [pk, default: `gen_random_uuid()`]
  creator_campaign_id uuid [not null]
  creator_id uuid [not null]
  campaign_id uuid [not null]
  creator_account_id uuid [not null]
  video_id uuid [not null]
  status text [not null, default: 'selected', check: `status IN ('selected','published','removed')`]
  post_url text [unique]
  posted_at timestamptz
  views bigint [not null, default: 0, check: `views >= 0`]
  views_updated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    campaign_id
    creator_campaign_id
    status
  }
  checks { `status <> 'published' OR (post_url IS NOT NULL AND posted_at IS NOT NULL)` }
  Note: 'SQL REQUIRED (D011): BEFORE INSERT derive creator_id from auth.uid(), campaign_id from video, creator_campaign_id from active enrollment. Client INSERT permits only creator_account_id and video_id. Composite FKs plus owner RLS enforce ownership; account platform matches script and video must be approved. All relationship IDs immutable immediately after INSERT. Owner calls confirm_post RPC with post_url and posted_at; backend canonicalizes URL and performs selected-to-published transition. Repeated identical confirmation is idempotent; removed is terminal. Views updated through owner-authorized API and labelled manual/unverified; views_updated_at server-managed. No direct client status or ownership writes.'
}
Ref: published_posts.(creator_campaign_id, creator_id, campaign_id) > creator_campaigns.(id, creator_id, campaign_id)
Ref: published_posts.(creator_account_id, creator_id) > creator_accounts.(id, creator_id)
Ref: published_posts.(video_id, campaign_id) > videos.(id, campaign_id)

// 12. One tracking link for one selected/published post.
Table tracking_links {
  id uuid [pk, default: `gen_random_uuid()`]
  published_post_id uuid [not null, unique, ref: - published_posts.id]
  slug text [not null, unique]
  destination_url text [not null]
  status text [not null, default: 'active', check: `status IN ('active','disabled')`]
  created_at timestamptz [not null, default: `now()`]
  Note: 'SQL REQUIRED: derive + validate destination from product affiliate_url; never allow arbitrary client redirects. Preserve affiliate parameters and add click_id through agreed merchant integration. Immutable post association. New eligible clicks require active enrollment/campaign within dates, nonremoved post and approved video. Otherwise reject tracking redirect with inactive-link response. Historical eligible clicks retain attribution within configured window after exit/end. No new link requires an already published URL.'
}

// 13. Clicks only for pilot; no impression/landing pipeline.
Table tracking_events {
  id uuid [pk, default: `gen_random_uuid()`, note: 'This IS the click_id sent to merchant.']
  tracking_link_id uuid [not null, ref: > tracking_links.id]
  event_type text [not null, default: 'click', check: `event_type = 'click'`]
  visitor_id text
  occurred_at timestamptz [not null, default: `now()`]
  indexes { (tracking_link_id, occurred_at) }
  Note: 'Server redirect handler only. Each redirect gets new click_id. No commission from raw clicks. Store minimal visitor data; click counts are raw observed clicks, not verified unique humans.'
}

// ============================================================================
// SECTION 6 — CONVERSION, ELIGIBILITY, COMMISSION
// ============================================================================

// 14. Events persisted FIRST; eligibility resolved by one transactional RPC.
Table conversions {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null, ref: > products.id]
  attributed_click_id uuid [ref: > tracking_events.id]
  source text [not null, note: 'Stable integration namespace; same namespace for import and webhook of same upstream event.']
  external_event_id text [not null]
  external_user_id text [not null]
  external_order_id text [note: 'Paid transaction/invoice ID; NOT subscription ID.']
  event_type text [not null, check: `event_type IN ('signup','trial','paid')`]
  amount numeric(14,2) [check: `amount >= 0`]
  currency varchar(3)
  status text [not null, default: 'valid', check: `status IN ('valid','voided')`]
  void_reason text
  eligibility_status text [not null, default: 'not_applicable', note: 'Derived server-side: not_applicable | pending | eligible | already_claimed | unattributed']
  eligibility_checked_at timestamptz
  attribution_snapshot jsonb [note: 'Selected click, policy version/window, reason; null click means unattributed.']
  occurred_at timestamptz [not null]
  received_at timestamptz [not null, default: `now()`]
  indexes {
    (product_id, source, external_event_id) [unique]
    (product_id, source, external_order_id) [unique]
    (product_id, source, external_user_id)
    (id, product_id, source, external_user_id) [unique]
    eligibility_status
  }
  checks {
    `(event_type = 'paid' AND external_order_id IS NOT NULL AND amount IS NOT NULL AND currency IS NOT NULL) OR (event_type IN ('signup','trial') AND external_order_id IS NULL AND amount IS NULL AND currency IS NULL)`
    `status <> 'voided' OR void_reason IS NOT NULL`
    `eligibility_status IN ('not_applicable','pending','eligible','already_claimed','unattributed')`
    `event_type = 'paid' OR (eligibility_status = 'not_applicable' AND eligibility_checked_at IS NULL)`
    `eligibility_status NOT IN ('eligible','already_claimed','unattributed') OR (event_type = 'paid' AND eligibility_checked_at IS NOT NULL)`
    `eligibility_status <> 'eligible' OR attributed_click_id IS NOT NULL`
    `eligibility_status <> 'unattributed' OR attributed_click_id IS NULL`
    `event_type <> 'paid' OR currency = 'USD'`
  }
  Note: 'SQL REQUIRED (D007): trusted ingest_conversion RPC only. Insert conversion before eligibility to satisfy immediate FK; no BEFORE INSERT eligibility claim. Validate payload and idempotency; retry existing event/order returns original result without rewriting attribution. Valid paid starts pending and is resolved before commit. First successful customer claim with valid click becomes eligible; without valid attribution becomes unattributed but still consumes eligibility. Customer-key conflict becomes already_claimed, still counts as revenue. Signup/trial and newly received voided events are not_applicable and do not claim. eligibility_checked_at set for processed paid events. Freeze identity, amount, currency and finalized attribution; status may be voided only by authorized atomic reversal before settlement. Keep original eligibility label for audit. Invalid click is stored as reason in snapshot; attributed_click_id is null. Do not infer attribution by matching visitor alone.'
}

// 15. NEW v1.3 (D007) — One-time eligibility gate per product customer.
Table commission_eligibility {
  product_id uuid [not null, ref: > products.id]
  source text [not null]
  external_user_id text [not null]
  first_paid_conversion_id uuid [not null, unique, note: 'First accepted valid paid event; composite FK guarantees exact customer identity.']
  first_creator_campaign_id uuid [ref: > creator_campaigns.id, note: 'Nullable only for first paid event without valid attribution.']
  claimed_at timestamptz [not null, default: `now()`]
  indexes {
    (product_id, source, external_user_id) [pk]
    (first_paid_conversion_id, first_creator_campaign_id) [unique]
  }
  Note: 'SQL REQUIRED: append-only gate. Claim AFTER conversion insert within same RPC transaction, using explicit customer-key ON CONFLICT DO NOTHING RETURNING. At most one winner; PK alone does not guarantee processing completeness. Winner must be valid paid at claim time. Enrollment must equal attributed click post enrollment, or null when unattributed. Retry same winner returns previous result, not already_claimed. No UPDATE/DELETE, including after void/refund. first accepted refers to successful DB claim order, not occurred_at. Out-of-order historical corrections require manual reconciliation before payment, never automatic reassignment.'
}

Ref: commission_eligibility.(first_paid_conversion_id, product_id, source, external_user_id) > conversions.(id, product_id, source, external_user_id)

// 16. Earnings + manual settlement; no wallet.
Table commissions {
  id uuid [pk, default: `gen_random_uuid()`]
  conversion_id uuid [not null, unique, ref: - conversions.id]
  creator_campaign_id uuid [not null, ref: > creator_campaigns.id]
  basis_amount numeric(14,2) [not null, check: `basis_amount >= 0`]
  amount numeric(14,2) [not null, check: `amount >= 0`]
  currency varchar(3) [not null, check: `currency = 'USD'`]
  calculation_snapshot jsonb [not null, note: 'Enrollment rate/type, revenue basis, rounding, pilot policy version.']
  status text [not null, default: 'pending', check: `status IN ('pending','approved','paid','reversed')`]
  approved_at timestamptz
  paid_at timestamptz
  payment_reference text
  payment_recorded_by uuid [ref: > auth.users.id]
  created_at timestamptz [not null, default: `now()`]
  indexes { 
    creator_campaign_id
    status
  }
  checks {
    `status <> 'paid' OR (paid_at IS NOT NULL AND payment_reference IS NOT NULL AND payment_recorded_by IS NOT NULL)`
    `status NOT IN ('approved','paid') OR approved_at IS NOT NULL`
  }
  Note: 'SQL REQUIRED: same ingest transaction creates commission only for valid paid eligible winner. Composite FK requires exact winning conversion AND enrollment; UNIQUE conversion_id limits to one commission. Nullable enrollment on unattributed eligibility cannot be matched by nonnull commission enrollment. Calculate from immutable enrollment snapshot; USD required and revenue basis/rounding snapshotted. Identity, calculation and amounts immutable. Settlement and void RPCs lock conversion then commission in same order and recheck status; no paying a voided event or voiding an already paid commission through pilot path. Reversal retains original amount but excludes earnings; eligibility never released. Manual full settlement after configured hold, with reference and trusted actor. No direct authenticated financial writes.'
}

Ref: commissions.(conversion_id, creator_campaign_id) > commission_eligibility.(first_paid_conversion_id, first_creator_campaign_id)

// ============================================================================
// MIGRATION / API GATES — required acceptance criteria, not DBML features
// ============================================================================
// 1. ALTER existing profile tables; preserve checks/triggers/RLS/grants. Fix
//    creators.user_id UNIQUE after duplicate inspection. Never recreate auth.users.
// 2. Normalize URLs/strings/platforms; preserve generated platform_handle. Set
//    updated_at server-side. Validate JSON schemas and all USD currency fields.
// 3. Owner RLS on profiles/posts/earnings; creators discover eligible campaigns
//    and approved video packages. Raw PKB/evidence/jobs are private. Since videos
//    contain evidence, use safe API DTOs/column grants, not unrestricted SELECT *.
//    Scripts are backend-only writes, with owning merchant/admin reads.
// 4. Client selects account/video; server derives post ownership. Immutable FKs
//    from initial insert. confirm_post RPC sets posted_at/status after ownership
//    checks. Manual views API sets views_updated_at and labels data unverified.
// 5. Enrollment RPC: lock campaign FOR UPDATE, validate eligibility/dates, set
//    terms_locked_at once, snapshot, insert. Lock campaign before enrollment.
//    Reject locked terms edits, marker clearing, enrollment DELETE/reassignment.
//    Creator rejoin retains original joined_at/snapshots. Removed requires admin.
// 6. first_approved_at is permanent: freeze content, lineage and approval metadata
//    forever after approval, including during/after archive. Notes remain admin
//    editable. Revisions are new rows; archived is terminal. File bytes at referenced
//    Storage paths must also be immutable; replacing bytes must create a new path.
// 7. ingest_conversion RPC is the sole ingestion/claim/commission transaction:
//    validate -> insert/dedup event -> claim eligibility -> label -> commission.
//    Persist conversion FIRST (not a BEFORE INSERT claim). Use explicit customer
//    conflict target and RETURNING. Losers retain valid revenue, no commission.
//    Retry returns existing result. No request commits a valid paid row as pending.
//    Commission failure rolls back newly inserted conversion and eligibility too.
// 8. Eligibility customer key matches winning conversion via composite FK.
//    Commission must match winning conversion/enrollment via composite FK. Trigger
//    or trusted function also validates paid status and click enrollment. Freeze
//    identity columns. Prevent direct SQL paths bypassing required business gates.
// 9. First valid accepted paid consumes eligibility even without attribution.
//    No automatic reallocation after refund or historical earlier event. Merchant
//    customer IDs/source namespaces must be canonical and stable across import
//    and webhook. True lifetime first purchase needs merchant evidence; not assumed.
// 10. Attribution: merchant returns authenticated click_id, within configured
//     window, same product and timestamp order. Signup-to-paid can reuse previously
//     verified acquisition click for same customer only within window. Define a
//     single canonical returned-click policy in integration contract. Record policy
//     version/reason. Missing attribution never creates a commission.
// 11. Configure attribution_window_days (>0), settlement_hold_days (>=0), approved
//     revenue_basis and policy_version before paid ingest; fail configuration check
//     if absent. USD only. These values are operational launch requirements.
//     Record the basis and eligible amount in calculation_snapshot/basis_amount.
// 12. Void full payment before payout atomically reverses commission (if any), but
//     never removes eligibility. Lock conversion then commission for both payment
//     and void operations. Post-payment/partial refunds require manual reconciliation
//     outside automated pilot. Keep original amounts; do not rewrite history.
// 13. Restrict deletes on historical products/campaigns/content/conversions/earnings.
//     Archive instead. Prevent auth deletion from cascading into earnings. Restrict
//     mutation of all referenced lineage; approved PKB cannot be overwritten.
// 14. Worker retries are idempotent; claim job atomically with bounded retries.
//     Sync script endpoint authorizes caller, validates approved PKB and uses
//     request idempotency. Service credentials remain server-side; admin identity
//     is verified, never supplied/trusted blindly from client.
// 15. Revenue = valid paid events, including already_claimed/unattributed. Paid
//     users = distinct canonical customer keys. Earnings exclude reversed amounts.
//     Views are current manually reported totals; clicks are observed redirects.
//     Financial dashboards must distinguish merchant sales revenue vs commission.
// 16. Update M1 specification/API contract for simplified JSON sources/assets,
//     no vector RAG and sync scripts. FE/AI/BE share one versioned JSON contract.
// 17. Minimum integration tests: parallel same-customer claims; retry same order;
//     unattributed first payment then attributed repeat; rollback on commission
//     failure; first enrollment vs terms edit; cross-owner post; archive freeze;
//     concurrent void vs payout; late events still counted as revenue; invalid
//     currency/config rejection; FK prevents commission for nonwinning conversion.
// 18. SQL REQUIRED (video flag) — PLANNED, not implemented, no trigger/RPC/policy
//     added in this task: when merchant_flagged_at IS NOT NULL, merchant_flag_reason
//     must be non-empty. CHECK:
//     (merchant_flagged_at IS NULL AND merchant_flag_reason IS NULL)
//     OR (merchant_flagged_at IS NOT NULL
//         AND merchant_flag_reason IS NOT NULL
//         AND char_length(btrim(merchant_flag_reason)) > 0)
//     Only the merchant owning the video product may set these columns; the server
//     supplies merchant_flagged_at. Flagging must not approve/reject/archive/remove
//     the video or change its status.
// 19. SQL REQUIRED (generation_jobs cost) — PLANNED, not implemented in this task:
//     worker writes only cost_breakdown (cost_breakdown v1); the database derives
//     tokens_in, tokens_out and cost_usd from it. Validation to add: call_id unique
//     within items, and tokens_in_cached <= tokens_in per applicable item.
//     Additionally, the 3 total columns must be non-null when cost_breakdown is a
//     valid v1 payload (not '{}') and null when cost_breakdown = '{}', so that
//     "not yet measured" stays distinct from "measured as zero". Enforce in worker
//     validation or trigger, not a simple CHECK (validating a JSONB payload against
//     schema v1 needs application logic). See 22 for the content_scripts mirror.
// 20. SQL REQUIRED (review_note) — PLANNED, not implemented in this task: when
//     status = 'rejected', review_note must be non-empty. CHECK:
//     (status <> 'rejected' OR (review_note IS NOT NULL
//         AND char_length(btrim(review_note)) > 0)). When status = 'approved',
//     review_note is optional. Max length 1000 characters.
// 21. SQL REQUIRED (PKB review consistency) — PLANNED, not implemented in this task:
//     status = 'approved' → reviewed_by NOT NULL, reviewed_at NOT NULL, reviewer_role = 'merchant';
//     status = 'rejected' → reviewed_by NOT NULL, reviewed_at NOT NULL, reviewer_role IN ('merchant','admin'), review_note NOT NULL and non-empty;
//     status IN ('draft','in_review') → reviewed_by NULL, reviewed_at NULL, reviewer_role NULL, review_note NULL.
//     Enforcement via trigger or application-level check; a single CHECK constraint cannot express this combination reliably.
// 22. SQL REQUIRED (content_scripts cost) — PLANNED, not implemented in this task:
//     same nullability and derivation rules as generation_jobs.cost_usd. Worker or
//     backend writes cost_breakdown; the database derives cost_usd from it.
//     Enforcement mirrors generation_jobs: cost_breakdown = valid v1 payload ->
//     cost_usd NOT NULL; cost_breakdown = '{}' -> cost_usd NULL.
// 23. Nullability/default of generation_jobs tokens_in, tokens_out, cost_usd is by
//     design (Issue #23), not an open gap: keep them nullable with no default so
//     "not yet measured" differs from "measured as zero" (see the cost note on the
//     table). No schema change for generation_jobs in this task.

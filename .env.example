# Copy thành .env.local rồi điền giá trị thật. KHÔNG commit file .env*.
# Lấy giá trị local bằng: pnpm dlx supabase status (chạy trong repo AI-review-BE)

# Public: được đưa xuống trình duyệt
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: chỉ dùng trong Server Components / Route Handlers, KHÔNG thêm tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: để trống để chạy review với dữ liệu mẫu và video local.
# Chỉ cấu hình khi BE đã hỗ trợ hợp đồng review/search mô tả trong tài liệu Sprint 1.
# Không trỏ tới worker /health hiện tại: worker chưa triển khai các endpoint này.
REVIEW_API_BASE_URL=
